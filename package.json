{
  "name": "tukio",
  "version": "0.0.0",
  "private": true,
  "description": "Tukio — Event-services marketplace (B2B2C). Pays de la Loire pilot.",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.5.0",
    "turbo": "^2.9.0",
    "typescript": "^5.6.0"
  }
}
