# review-svc — environment variables (Sprint 0 / Story 0.10)
# Copy to `.env.local` and adjust for your dev environment.

NODE_ENV=development
SERVICE_NAME=review-svc
SERVICE_VERSION=0.0.0
PORT=4007
LOG_LEVEL=info

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=tukio
DB_PASSWORD=tukio_dev_password
DB_NAME=tukio_review

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=tukio
KEYCLOAK_CLIENT_ID=tukio-api
KEYCLOAK_AUDIENCE=tukio-api

# NATS
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=TUKIO_REVIEW
NATS_REPLICAS=1

# Redis
REDIS_URL=redis://localhost:6379
