# payment-svc — environment variables (Sprint 0 / Story 0.10)
# Copy to `.env.local` and adjust for your dev environment.

NODE_ENV=development
SERVICE_NAME=payment-svc
SERVICE_VERSION=0.0.0
PORT=4005
LOG_LEVEL=info

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=tukio
DB_PASSWORD=tukio_dev_password
DB_NAME=tukio_payment

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=tukio
KEYCLOAK_CLIENT_ID=tukio-api
KEYCLOAK_AUDIENCE=tukio-api

# NATS
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=TUKIO_PAYMENT
NATS_REPLICAS=1

# Stripe — test mode credentials (override via Doppler in V0+)
# Story 2.1 wires Stripe Connect Express; until then, leave placeholders.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_API_VERSION=2024-12-18.acacia

# Redis
REDIS_URL=redis://localhost:6379
