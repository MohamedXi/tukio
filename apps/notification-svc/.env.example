# notification-svc — environment variables (Sprint 0 / Story 0.10)
# Copy to `.env.local` and adjust for your dev environment.

NODE_ENV=development
SERVICE_NAME=notification-svc
SERVICE_VERSION=0.0.0
PORT=4008
LOG_LEVEL=info

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=tukio
DB_PASSWORD=tukio_dev_password
DB_NAME=tukio_notification

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=tukio
KEYCLOAK_CLIENT_ID=tukio-api
KEYCLOAK_AUDIENCE=tukio-api

# NATS (cross-service event consumer — Story 5.4)
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=TUKIO_NOTIFICATION
NATS_REPLICAS=1

# SMTP — MailHog in dev (UI: http://localhost:8025), Resend in V0+
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@tukio.dev
SMTP_SECURE=false
# RESEND_API_KEY=re_replace_me     # uncomment in V0+ when wiring Resend

# Redis (template caching)
REDIS_URL=redis://localhost:6379
