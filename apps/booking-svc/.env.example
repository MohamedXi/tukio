# booking-svc — environment variables (Sprint 0 / Story 0.10)
# Copy to `.env.local` and adjust for your dev environment.

NODE_ENV=development
SERVICE_NAME=booking-svc
SERVICE_VERSION=0.0.0
PORT=4003
LOG_LEVEL=info

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=tukio
DB_PASSWORD=tukio_dev_password
DB_NAME=tukio_booking

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=tukio
KEYCLOAK_CLIENT_ID=tukio-api
KEYCLOAK_AUDIENCE=tukio-api

# NATS (saga orchestrator — Epic 4)
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=TUKIO_BOOKING
NATS_REPLICAS=1

# Redis (locks for race-condition protection — Story 4.4)
REDIS_URL=redis://localhost:6379
