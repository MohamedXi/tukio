# media-svc — environment variables (Sprint 0 / Story 0.10)
# Copy to `.env.local` and adjust for your dev environment.

NODE_ENV=development
SERVICE_NAME=media-svc
SERVICE_VERSION=0.0.0
PORT=4009
LOG_LEVEL=info

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=tukio
DB_PASSWORD=tukio_dev_password
DB_NAME=tukio_media

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=tukio
KEYCLOAK_CLIENT_ID=tukio-api
KEYCLOAK_AUDIENCE=tukio-api

# NATS
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=TUKIO_MEDIA
NATS_REPLICAS=1

# Cloudflare Images / R2 (Story 3.4 — wired in V0+)
# CLOUDFLARE_ACCOUNT_ID=replace_me
# CLOUDFLARE_IMAGES_API_TOKEN=replace_me
# CLOUDFLARE_IMAGES_ACCOUNT_HASH=replace_me

# Redis (signed upload URL cache)
REDIS_URL=redis://localhost:6379
