{
  "name": "identity-svc",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build --webpack",
    "dev": "nest start --watch --webpack",
    "start": "nest start --webpack",
    "start:dev": "nest start --watch --webpack",
    "start:debug": "nest start --debug --watch --webpack",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:cov": "jest --config jest.config.ts --coverage",
    "test:integration": "jest --config jest.integration.config.ts",
    "test:integration:cov": "jest --config jest.integration.config.ts --coverage",
    "test:e2e": "jest --config test/jest-e2e.json",
    "test:e2e:cov": "jest --config test/jest-e2e.json --coverage",
    "test:e2e:testcontainers": "jest --config jest.integration.config.ts test/customer-register.e2e-spec.ts",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/infrastructure/persistence/typeorm/data-source.ts",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/infrastructure/persistence/typeorm/data-source.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/infrastructure/persistence/typeorm/data-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@fastify/multipart": "^10.1.0",
    "@keycloak/keycloak-admin-client": "^26.7.0",
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-fastify": "^11.1.21",
    "@nestjs/typeorm": "^11.0.1",
    "@tukio/auth": "workspace:*",
    "@tukio/contracts": "workspace:*",
    "@tukio/messaging": "workspace:*",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.29",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.21",
    "@tukio/testing": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-prettier": "^5.2.2",
    "form-data": "^4.0.6",
    "globals": "^17.7.0",
    "jest": "^30.0.0",
    "nock": "^14.0.16",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.63.0",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  }
}
