# identity-svc — environment variables (Sprint 0 / Story 0.6)
# Copy to `.env.local` and adjust for your dev environment.

NODE_ENV=development
SERVICE_NAME=identity-svc
SERVICE_VERSION=0.0.0
PORT=4001
LOG_LEVEL=info

# Postgres — provisioned by Story 0.10 docker-compose
DB_HOST=localhost
DB_PORT=5432
DB_USER=tukio_identity_user
DB_PASSWORD=changeme
DB_NAME=tukio_identity
# DB_VERBOSE=false   # set to "true" to log every SQL query (dev only)

# Keycloak — wired for real in Story 0.8 (@tukio/auth TukioAuthModule)
# Provisioned by Story 0.10 docker-compose + Story 1.1 realm provisioning
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=tukio
KEYCLOAK_CLIENT_ID=tukio-api
KEYCLOAK_AUDIENCE=tukio-api

# NATS — wired for real in Story 0.7 (@tukio/messaging OutboxRelayService)
# Provisioned by Story 0.10 docker-compose with nats-server + JetStream enabled
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=TUKIO_IDENTITY
NATS_REPLICAS=1
