# identity-svc — environment variables (Sprint 0 / Story 0.6 + Story 0.10)
# Copy to `.env.local` and adjust for your dev environment.

NODE_ENV=development
SERVICE_NAME=identity-svc
SERVICE_VERSION=0.0.0
PORT=4001
LOG_LEVEL=info

# Postgres — provisioned by `pnpm docker:up:wait && pnpm docker:bootstrap`
# Story 0.10 standardizes on a single shared user 'tukio' for all logical
# databases at MVP; V1+ can split per-service users with row-level security.
DB_HOST=localhost
DB_PORT=5432
DB_USER=tukio
DB_PASSWORD=tukio_dev_password
DB_NAME=tukio_identity
# DB_VERBOSE=false   # set to "true" to log every SQL query (dev only)

# Keycloak — provisioned by `infra/scripts/bootstrap-keycloak-realm.sh`
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=tukio
KEYCLOAK_CLIENT_ID=tukio-api
KEYCLOAK_AUDIENCE=tukio-api

# NATS — provisioned by docker-compose.dev.yml (JetStream enabled)
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=TUKIO_IDENTITY
NATS_REPLICAS=1

# Redis (rate limiting, caching — Stories Epic 1+)
REDIS_URL=redis://localhost:6379

# SMTP — MailHog in dev (UI: http://localhost:8025), Resend in V0+
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@tukio.dev

# Story 1.2b — Customer registration
# Service-account secret for the `tukio-api` Keycloak confidential client
# provisioned by Story 1.1 (used by KeycloakAdminService for user creation).
# In dev/test, env.schema injects 'tukio-api-dev-secret' if missing — adjust
# to match the actual realm export value (see infra/keycloak/realm-export/).
# In production, MUST be set explicitly via the secret store.
KEYCLOAK_CLIENT_SECRET_TUKIO_API=tukio-api-dev-secret

# HMAC-shared secret for the InternalServiceGuard on `/internal/*` endpoints.
# The gateway-api (Story 1.2c) signs requests with this secret; identity-svc
# verifies the signature. Base64-encoded random bytes ≥ 32 chars. In dev/test
# the env.schema injects 'dev-internal-svc-secret-32-bytes!!' if missing — must
# match the value configured on gateway-api side. In production, MUST be set
# explicitly via the secret store (env.schema refuses to boot otherwise).
TUKIO_INTERNAL_SERVICE_SECRET=dev-internal-svc-secret-32-bytes!!

# Public-facing apex URL used to build verify-email links in
# `notification.email.send.v1` event payloads (consumed by notification-svc
# Story 5.4 to render Resend templates).
PUBLIC_BASE_URL=http://localhost:3000

# Story 1.3b — INSEE SIRENE V3.11 apiKey (required for pro registration).
# Deviation from parent story: apiKey direct (not OAuth2 client_credentials).
# In dev/test, the env.schema allows the key to be empty — INSEE calls will
# fail with 401 unless the key is set. In production, set via secret store.
INSEE_API_URL=https://api.insee.fr
INSEE_API_KEY=

# Story 1.3b — Cloudflare R2 KYC bucket (required for pro registration).
# Endpoint format: https://<account_id>.eu.r2.cloudflarestorage.com
# Bucket `tukio-kyc-staging` is pre-provisioned on Cloudflare R2 (2026-05-16).
# In production, set all 4 values via secret store (droplet secrets).
R2_KYC_ENDPOINT=
R2_KYC_ACCESS_KEY_ID=
R2_KYC_SECRET_ACCESS_KEY=
R2_KYC_BUCKET=tukio-kyc-staging
