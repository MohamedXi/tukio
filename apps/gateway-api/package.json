{
  "name": "gateway-api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build --webpack",
    "dev": "nest start --watch --webpack",
    "start": "nest start --webpack",
    "start:dev": "nest start --watch --webpack",
    "start:debug": "nest start --debug --watch --webpack",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:cov": "jest --config ./test/jest-e2e.json --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.0.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-fastify": "^11.1.21",
    "@nestjs/throttler": "^6.5.0",
    "@tukio/auth": "workspace:*",
    "@tukio/contracts": "workspace:*",
    "@tukio/messaging": "workspace:*",
    "axios": "^1.16.1",
    "axios-retry": "^4.5.0",
    "form-data": "^4.0.5",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.21",
    "@tukio/testing": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/supertest": "^7.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "nock": "^14.0.15",
    "prettier": "^3.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node",
            "esModuleInterop": true,
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true,
            "resolvePackageJsonExports": false,
            "allowJs": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!.*?(jose)/)"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@tukio/contracts$": "<rootDir>/../../../packages/contracts/src/index.ts",
      "^@tukio/contracts/exceptions/domain$": "<rootDir>/../../../packages/contracts/src/exceptions/domain.exception.ts",
      "^@tukio/contracts/exceptions$": "<rootDir>/../../../packages/contracts/src/exceptions/index.ts",
      "^@tukio/contracts/(.*)\\.js$": [
        "<rootDir>/../../../packages/contracts/src/$1.ts",
        "<rootDir>/../../../packages/contracts/src/$1.dto.ts",
        "<rootDir>/../../../packages/contracts/src/$1.exception.ts",
        "<rootDir>/../../../packages/contracts/src/$1/index.ts"
      ],
      "^@tukio/contracts/(.*)$": [
        "<rootDir>/../../../packages/contracts/src/$1.ts",
        "<rootDir>/../../../packages/contracts/src/$1.dto.ts",
        "<rootDir>/../../../packages/contracts/src/$1.exception.ts",
        "<rootDir>/../../../packages/contracts/src/$1/index.ts"
      ],
      "^@tukio/auth$": "<rootDir>/../../../packages/auth/src/index.ts",
      "^@tukio/auth/module$": "<rootDir>/../../../packages/auth/src/tukio-auth.module.ts",
      "^@tukio/auth/guards$": "<rootDir>/../../../packages/auth/src/guards/keycloak-jwt.guard.ts",
      "^@tukio/auth/guards/roles$": "<rootDir>/../../../packages/auth/src/guards/roles.guard.ts",
      "^@tukio/auth/decorators$": "<rootDir>/../../../packages/auth/src/decorators/roles.decorator.ts",
      "^@tukio/auth/decorators/public$": "<rootDir>/../../../packages/auth/src/decorators/public.decorator.ts",
      "^@tukio/auth/decorators/current-actor$": "<rootDir>/../../../packages/auth/src/decorators/current-actor.decorator.ts",
      "^@tukio/auth/exceptions$": "<rootDir>/../../../packages/auth/src/exceptions/index.ts",
      "^@tukio/messaging/correlation$": "<rootDir>/../../../packages/messaging/src/correlation/correlation-context.module.ts",
      "^@tukio/messaging/correlation/context$": "<rootDir>/../../../packages/messaging/src/correlation/correlation-context.ts",
      "^@tukio/messaging/correlation/middleware$": "<rootDir>/../../../packages/messaging/src/correlation/correlation.middleware.ts"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
