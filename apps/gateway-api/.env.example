# gateway-api — environment variables (Stories 0.10 + 1.2c)
# Copy to `.env.local` and adjust for your dev environment.

NODE_ENV=development
SERVICE_NAME=gateway-api
SERVICE_VERSION=0.0.0
PORT=4000
LOG_LEVEL=info

# Keycloak JWT validation (KeycloakJwtGuard — Story 0.8). Gateway is a public
# client; no client secret needed (only validates tokens via JWKS).
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=tukio
KEYCLOAK_CLIENT_ID=tukio-api
KEYCLOAK_AUDIENCE=tukio-api

# Downstream identity-svc client (Story 1.2c — POST /internal/customers).
IDENTITY_SVC_URL=http://localhost:4001
IDENTITY_SVC_TIMEOUT_MS=5000
IDENTITY_SVC_RETRIES=3

# Other downstream service URLs (used by future stories — Epic 2+).
CATALOG_SVC_URL=http://localhost:4002
BOOKING_SVC_URL=http://localhost:4003
ORDER_SVC_URL=http://localhost:4004
PAYMENT_SVC_URL=http://localhost:4005
MESSAGING_SVC_URL=http://localhost:4006
REVIEW_SVC_URL=http://localhost:4007
NOTIFICATION_SVC_URL=http://localhost:4008
MEDIA_SVC_URL=http://localhost:4009

# Redis — Story 0.10 dev container. Backs `@nestjs/throttler` rate-limit storage.
REDIS_URL=redis://localhost:6379

# Throttler scopes (Architecture lines 703-708).
# `default` 60/min/IP applied everywhere by ThrottlerModule.
# `sensitive` 5/min/IP — applied via per-route `@Throttle` overrides (register,
# login, password reset, payment endpoints). NFR10.
THROTTLER_DEFAULT_LIMIT=60
THROTTLER_DEFAULT_TTL_MS=60000
THROTTLER_SENSITIVE_LIMIT=5
THROTTLER_SENSITIVE_TTL_MS=60000

# HMAC-shared secret used to sign forwarded calls to identity-svc /internal/*
# endpoints (Story 1.2b InternalServiceGuard). MUST match identity-svc's value.
# Base64-encoded random bytes (≥ 32). No default in production.
TUKIO_INTERNAL_SERVICE_SECRET=dev-internal-svc-secret-32-bytes!!

# Public apex (forwarded to downstream services that build verify-email links).
PUBLIC_BASE_URL=http://localhost:3000
