# gateway-api — environment variables (Sprint 0 / Story 0.10)
# Copy to `.env.local` and adjust for your dev environment.

NODE_ENV=development
SERVICE_NAME=gateway-api
SERVICE_VERSION=0.0.0
PORT=4000
LOG_LEVEL=info

# Keycloak JWT validation (KeycloakJwtGuard — Story 0.8)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=tukio
KEYCLOAK_CLIENT_ID=tukio-api
KEYCLOAK_AUDIENCE=tukio-api

# NATS request/reply to downstream microservices
NATS_URL=nats://localhost:4222

# Redis (rate limiting, response cache — Stories Epic 1+)
REDIS_URL=redis://localhost:6379

# Downstream service URLs (for HTTP fallback / health probes)
IDENTITY_SVC_URL=http://localhost:4001
CATALOG_SVC_URL=http://localhost:4002
BOOKING_SVC_URL=http://localhost:4003
ORDER_SVC_URL=http://localhost:4004
PAYMENT_SVC_URL=http://localhost:4005
MESSAGING_SVC_URL=http://localhost:4006
REVIEW_SVC_URL=http://localhost:4007
NOTIFICATION_SVC_URL=http://localhost:4008
MEDIA_SVC_URL=http://localhost:4009
