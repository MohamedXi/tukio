# Tukio — root environment template (Story 0.10)
#
# These variables are shared across the monorepo and are consumed by the
# infra scripts (bootstrap-databases.sh, bootstrap-keycloak-realm.sh,
# seed-categories.ts). Copy to `.env.local` and adjust as needed.

# ─── Postgres (Docker Compose dev) ─────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=tukio
PG_PASSWORD=tukio_dev_password

# ─── Keycloak (Docker Compose dev) ─────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_CONTAINER=tukio_keycloak
KEYCLOAK_REALM=tukio
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Dev-only secret for the confidential M2M client. Override via Doppler in V0+.
TUKIO_API_CLIENT_SECRET=tukio_api_dev_secret

# ─── Meilisearch (Docker Compose dev) ──────────────────────────────────
MEILI_MASTER_KEY=tukio_dev_master_key_change_in_prod

# ─── Redis (Docker Compose dev) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── SMTP (MailHog in dev → Resend in V0+) ─────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@tukio.dev
