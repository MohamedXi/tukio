# Tukio reverse-proxy + Let's Encrypt TLS auto.
# Deployed on droplet `tukio-apps`, only container with public ports 80/443.
#
# `{$DATA_PRIV_IP}` is sourced from .env.production (DO VPC private IP of tukio-data).
#
# Topology (Story 0.14, ADR-016):
#   tukio.one        → public:3000  (visitors + authenticated B2C customers, unified tunnel)
#   seller.tukio.one → seller:3002  (B2B pros)
#   admin.tukio.one  → admin:3003   (staff console)
#   api.tukio.one    → gateway-api:4000
#   auth.tukio.one   → keycloak (cross-droplet via VPC)
# Legacy `app.tukio.one` 301-redirects to the apex for ~6 months; legacy
# `customer.tukio.one` is dropped (post-merge).
#
# Staging access control — Caddy basic_auth + IP whitelist.
# Whitelisted IPs bypass auth entirely; all other clients must present
# valid credentials before Caddy proxies the request upstream.
# api.tukio.one and auth.tukio.one are intentionally excluded:
#   - api.tukio.one  : protected by Keycloak JWT; basic_auth would break XHR
#   - auth.tukio.one : Keycloak must be publicly reachable for OIDC flows
# To add an IP: append to the `remote_ip` list and redeploy.
# To rotate credentials: `caddy hash-password` → update hash below → redeploy.

{
	email tech-lead@tukio.one
	# Use HTTP-01 challenge by default; works without any DNS-01 plugin.
}

# ───────────────────────────────────────────────────────────────────
# Staging auth helpers (shared across protected frontends)
# ───────────────────────────────────────────────────────────────────

(staging_auth) {
	# Requests coming from whitelisted IPs bypass the login prompt.
	@whitelisted remote_ip 82.120.52.19
	# Everyone else must authenticate.
	@needs_auth not remote_ip 82.120.52.19
	basic_auth @needs_auth "Tukio Staging" {
		ismael.mohamed@tukio.one $2b$14$flrR01cOYX8eFmn6R6NDBeCUPwu3yl3XTjTFeBORoQpFa.ZbobU8G
	}
}

# ───────────────────────────────────────────────────────────────────
# Apex — visitors + authenticated B2C customers (unified tunnel)
# ───────────────────────────────────────────────────────────────────

tukio.one {
	import staging_auth
	reverse_proxy public:3000 {
		# Preserve the public Host header so Next.js / next-intl build
		# correct absolute URLs.
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		# Next.js middleware (next-intl) builds redirects using the server's
		# internal URL — including port 3000. Strip the port from any Location
		# header on the way back to the client so `/` → `/fr` redirects to
		# `https://tukio.one/fr` not `https://tukio.one:3000/fr`.
		header_down Location ":3000" ""
	}
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "interest-cohort=()"
	}
}

# ───────────────────────────────────────────────────────────────────
# Legacy redirects — bookmarked links from the multi-zones era (ADR-013).
# Keep for ~6 months then revisit.
# ───────────────────────────────────────────────────────────────────

app.tukio.one {
	redir https://tukio.one{uri} permanent
}

# ───────────────────────────────────────────────────────────────────
# B2B + admin frontends
# ───────────────────────────────────────────────────────────────────

seller.tukio.one {
	import staging_auth
	reverse_proxy seller:3002 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_down Location ":3002" ""
	}
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

admin.tukio.one {
	import staging_auth
	reverse_proxy admin:3003 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_down Location ":3003" ""
	}
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Admin app must never be cached or framed.
		X-Frame-Options DENY
		Cache-Control "no-store, no-cache, must-revalidate"
	}
}

# ───────────────────────────────────────────────────────────────────
# API gateway — NOT protected by basic_auth (Keycloak JWT + XHR calls)
# ───────────────────────────────────────────────────────────────────

api.tukio.one {
	reverse_proxy gateway-api:4000
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}
	# CORS handled by gateway-api itself (Story 0.6 envelope filter) — Caddy
	# stays out of the way here.
}

# ───────────────────────────────────────────────────────────────────
# Keycloak (cross-droplet via VPC private IP) — NOT protected (OIDC flows)
# ───────────────────────────────────────────────────────────────────

auth.tukio.one {
	reverse_proxy {$DATA_PRIV_IP}:8080 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}
	encode gzip zstd
}
