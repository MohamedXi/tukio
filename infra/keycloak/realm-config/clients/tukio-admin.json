{
  "clientId": "tukio-admin",
  "name": "Tukio Admin (public, MFA TOTP required)",
  "enabled": true,
  "publicClient": true,
  "protocol": "openid-connect",
  "standardFlowEnabled": true,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "implicitFlowEnabled": false,
  "redirectUris": ${REDIRECT_URIS_TUKIO_ADMIN},
  "webOrigins": ${REDIRECT_URIS_TUKIO_ADMIN},
  "defaultClientScopes": ["openid", "profile", "email", "roles", "tukio-locale-scope"],
  "optionalClientScopes": ["address", "phone", "offline_access"],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "access.token.lifespan": "300",
    "client.session.idle.timeout": "1800",
    "use.refresh.tokens": "true",
    "refresh.token.max.reuse": "0",
    "post.logout.redirect.uris": "+"
  }
}
