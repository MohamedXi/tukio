{
  "alias": "tukio-admin-mfa-required",
  "description": "Admin browser flow — TOTP REQUIRED (cloned from browser, OTP step forced REQUIRED)",
  "providerId": "basic-flow",
  "topLevel": true,
  "builtIn": false,
  "executions": [
    {
      "provider": "auth-cookie",
      "requirement": "ALTERNATIVE",
      "priority": 10
    },
    {
      "provider": "auth-spnego",
      "requirement": "DISABLED",
      "priority": 20
    },
    {
      "provider": "identity-provider-redirector",
      "requirement": "ALTERNATIVE",
      "priority": 25
    },
    {
      "displayName": "tukio-admin-forms",
      "requirement": "ALTERNATIVE",
      "priority": 30,
      "subFlow": true,
      "executions": [
        {
          "provider": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "displayName": "tukio-admin-totp-required",
          "requirement": "REQUIRED",
          "priority": 20,
          "subFlow": true,
          "executions": [
            {
              "provider": "auth-otp-form",
              "requirement": "REQUIRED",
              "priority": 10,
              "authConfig": {
                "otpType": "totp",
                "algorithm": "HmacSHA256",
                "digits": "6",
                "period": "30",
                "lookAheadWindow": "1",
                "initialCounter": "0"
              }
            }
          ]
        }
      ]
    }
  ]
}
