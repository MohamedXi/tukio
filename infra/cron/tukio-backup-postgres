# /etc/cron.d/tukio-backup-postgres
# Daily Postgres backup → Cloudflare R2 (Story 0.12).
# Owner: tukio user on the `tukio-data` droplet.
#
# Install:
#   sudo install -m 644 infra/cron/tukio-backup-postgres /etc/cron.d/tukio-backup-postgres
#   sudo systemctl restart cron

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# minute hour dom mon dow  user  command
15 3 * * * tukio /home/tukio/tukio/infra/scripts/backup-postgres.sh >> /var/log/tukio/backup-postgres.log 2>&1
