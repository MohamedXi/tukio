# /etc/cron.d/tukio-do-snapshot-data
# Daily DigitalOcean droplet snapshot for tukio-data (Story 0.12).
#
# Install on the data droplet:
#   sudo install -m 644 infra/cron/tukio-do-snapshot-data /etc/cron.d/tukio-do-snapshot-data
#   sudo systemctl restart cron

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# minute hour dom mon dow  user  command
30 4 * * * tukio /home/tukio/tukio/infra/scripts/do-snapshot.sh data >> /var/log/tukio/do-snapshot.log 2>&1
