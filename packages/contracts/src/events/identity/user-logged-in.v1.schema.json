{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tukio.one/schemas/identity/user-logged-in.v1.json",
  "title": "UserLoggedInV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "causationId",
    "actor",
    "aggregate",
    "payload"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "const": "identity.user.logged-in.v1" },
    "eventVersion": { "type": "string", "const": "v1" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "actor": {
      "type": "object",
      "required": ["userId", "role", "locale"],
      "additionalProperties": false,
      "properties": {
        "userId": { "type": "string" },
        "role": {
          "type": "string",
          "enum": [
            "client",
            "pro",
            "admin-support",
            "admin-modo",
            "admin-super",
            "system",
            "anonymous"
          ]
        },
        "locale": { "type": "string", "enum": ["fr", "en"] }
      }
    },
    "aggregate": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "user-profile" },
        "id": { "type": "string", "format": "uuid" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "locale", "role", "ipHash", "userAgentHash", "loggedInAt"],
      "properties": {
        "userId": { "type": "string", "format": "uuid" },
        "locale": { "type": "string", "enum": ["fr", "en"] },
        "role": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["client", "pro", "admin-support", "admin-modo", "admin-super"]
          }
        },
        "ipHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "userAgentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "loggedInAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
