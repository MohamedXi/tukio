{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tukio.one/schemas/payment/payment-intent-captured.v1.json",
  "title": "PaymentIntentCapturedV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "correlationId", "causationId", "actor", "aggregate", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "const": "payment.intent.captured.v1" },
    "eventVersion": { "type": "string", "const": "v1" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": {
      "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
    },
    "actor": {
      "type": "object",
      "required": ["userId", "role", "locale"],
      "additionalProperties": false,
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "pro", "admin-support", "admin-modo", "admin-super", "system", "anonymous"] },
        "locale": { "type": "string", "enum": ["fr", "en"] }
      }
    },
    "aggregate": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "payment-intent" },
        "id": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paymentIntentId", "bookingId", "orderId", "amount", "capturedAt", "stripeChargeId"],
      "properties": {
        "paymentIntentId": { "type": "string" },
        "bookingId": { "type": "string", "format": "uuid" },
        "orderId": { "type": "string", "format": "uuid" },
        "amount": {
          "type": "object",
          "required": ["amount", "currency"],
          "additionalProperties": false,
          "properties": {
            "amount": { "type": "integer", "minimum": 0 },
            "currency": { "type": "string", "const": "EUR" }
          }
        },
        "capturedAt": { "type": "string", "format": "date-time" },
        "stripeChargeId": { "type": "string" }
      }
    }
  }
}
