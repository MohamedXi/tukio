{
  "name": "@tukio/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Tukio design system — Tailwind v4 tokens (CSS-first), TS tokens, themes, components.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles/theme.css": "./src/styles/theme.css",
    "./styles/globals.css": "./src/styles/globals.css",
