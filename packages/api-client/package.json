{
  "name": "@tukio/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed HTTP client wrapping gateway-api endpoints with envelope-handler ADR-014 + TanStack Query 5.x hooks.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/axios-client.ts",
    "./client/envelope": "./src/client/envelope-handler.ts",
    "./types": "./src/types/index.ts",
    "./types/api-error": "./src/types/api-error.ts",
    "./types/query-keys": "./src/types/query-keys.ts",
    "./providers": "./src/providers/query-provider.tsx",
    "./providers/api-client-context": "./src/providers/api-client-context.tsx",
    "./hooks/catalog": "./src/hooks/catalog/index.ts",
    "./hooks/catalog/*": "./src/hooks/catalog/*.ts",
    "./hooks/booking": "./src/hooks/booking/index.ts",
    "./hooks/booking/*": "./src/hooks/booking/*.ts",
    "./hooks/payment": "./src/hooks/payment/index.ts",
    "./hooks/payment/*": "./src/hooks/payment/*.ts",
    "./hooks/messaging": "./src/hooks/messaging/index.ts",
    "./hooks/messaging/*": "./src/hooks/messaging/*.ts",
    "./hooks/review": "./src/hooks/review/index.ts",
    "./hooks/review/*": "./src/hooks/review/*.ts",
    "./hooks/identity": "./src/hooks/identity/index.ts",
    "./hooks/identity/*": "./src/hooks/identity/*.ts",
    "./hooks/admin": "./src/hooks/admin/index.ts",
    "./hooks/admin/*": "./src/hooks/admin/*.ts",
    "./hooks/use-acquisition-tracking": "./src/hooks/use-acquisition-tracking.ts",
    "./hooks/pre-launch": "./src/hooks/pre-launch/index.ts",
    "./hooks/pre-launch/*": "./src/hooks/pre-launch/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.83.0",
    "axios": "^1.13.2"
  },
  "peerDependencies": {
    "@tukio/contracts": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@tukio/contracts": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.4.1",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.8"
  }
}
